{
  "name": "elFinder",
  "description": "File manager for web",
  "main": "Jakefile.js",
  "scripts": {
    "build": "mkdir -p ./build && jake -C ./build elfinder",
    "build-minimal": "mkdir -p ./build && jake -C ./build elfinder-minimal",
    "test:build": "node tests/security/build.cjs",
    "test:browser": "playwright test -c tests/security/e2e/playwright.config.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Studio-42/elFinder.git"
  },
  "keywords": [
    "file",
    "manager",
    "jquery",
    "jqueryui",
    "frontend",
    "client-side",
    "browser"
  ],
  "author": "Studio 42",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/Studio-42/elFinder/issues"
  },
  "homepage": "http://studio-42.github.io/elFinder/",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "csso": "^5.0.5",
    "jake": "^13.0.3",
    "uglify-js": "^3.19.3"
  },
  "overrides": {
    "filelist": {
      "minimatch": "^11.0.5"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
